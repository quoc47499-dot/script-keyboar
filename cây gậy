-- 2. HÀM TẠO BÚA LÒ XO
-- ==========================================
local function createSpringHammer()
	local leftHand = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	if not leftHand then return end

	local hammerModel = Instance.new("Model")
	hammerModel.Name = "SpringHammerModel"

	local mainColor = Color3.fromRGB(35, 38, 45)
	local glassMaterial = Enum.Material.Glass
	local glassTrans = 0.55

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(6.5, 0.45, 0.45)
	handle.Shape = Enum.PartType.Cylinder
	handle.Color = mainColor
	handle.Material = glassMaterial
	handle.Transparency = glassTrans
	handle.CanCollide = false
	handle.Parent = hammerModel

	local hammerBody = Instance.new("Part")
	hammerBody.Name = "HammerBody"
	hammerBody.Shape = Enum.PartType.Cylinder
	hammerBody.Size = Vector3.new(2.8, 2.8, 2.8)
	hammerBody.Color = mainColor
	hammerBody.Material = glassMaterial
	hammerBody.Transparency = glassTrans
	hammerBody.CanCollide = false
	hammerBody.Parent = hammerModel

	local bodyWeld = Instance.new("Weld")
	bodyWeld.Part0 = handle
	bodyWeld.Part1 = hammerBody
	bodyWeld.C0 = CFrame.new(-2.2, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
	bodyWeld.Parent = handle

	local steps = 5
	local baseOffset = 1.4
	local totalThickness = 0.8

	for _, dir in ipairs({1, -1}) do
		for i = 1, steps do
			local alpha = i / steps
			local thickness = totalThickness / steps
			local currentDiameter = 2.8 * (1 - alpha * 0.42)
			local distOffset = baseOffset + (i - 0.5) * thickness

			local capSegment = Instance.new("Part")
			capSegment.Name = "TaperedCap"
			capSegment.Shape = Enum.PartType.Cylinder
			capSegment.Size = Vector3.new(thickness, currentDiameter, currentDiameter)
			capSegment.Color = mainColor
			capSegment.Material = glassMaterial
			capSegment.Transparency = glassTrans
			capSegment.CanCollide = false
			capSegment.Parent = hammerModel

			local capWeld = Instance.new("Weld")
			capWeld.Part0 = hammerBody
			capWeld.Part1 = capSegment
			capWeld.C0 = CFrame.new(dir * distOffset, 0, 0)
			capWeld.Parent = hammerBody
		end
	end

	local centerBelt = Instance.new("Part")
	centerBelt.Name = "CenterBelt"
	centerBelt.Shape = Enum.PartType.Cylinder
	centerBelt.Size = Vector3.new(0.9, 3.0, 3.0)
	centerBelt.Color = Color3.fromRGB(20, 22, 28)
	centerBelt.Material = Enum.Material.SmoothPlastic
	centerBelt.Transparency = 0.2
	centerBelt.CanCollide = false
	centerBelt.Parent = hammerModel

	local beltWeld = Instance.new("Weld")
	beltWeld.Part0 = hammerBody
	beltWeld.Part1 = centerBelt
	beltWeld.C0 = CFrame.new(0, 0, 0)
	beltWeld.Parent = hammerBody

	for i = 1, 8 do
		local spike = Instance.new("Part")
		spike.Name = "Spike"
		spike.Size = Vector3.new(0.35, 0.35, 0.35)
		spike.Color = Color3.fromRGB(15, 15, 18)
		spike.Material = Enum.Material.SmoothPlastic
		spike.CanCollide = false
		spike.Parent = hammerModel

		local angle = math.rad(i * (360 / 8))
		local xOffset = math.cos(angle) * 1.55
		local zOffset = math.sin(angle) * 1.55

		local spikeWeld = Instance.new("Weld")
		spikeWeld.Part0 = centerBelt
		spikeWeld.Part1 = spike
		spikeWeld.C0 = CFrame.new(0, xOffset, zOffset) * CFrame.Angles(angle, 0, 0)
		spikeWeld.Parent = centerBelt
	end

	local coilCount = 20
	for i = 1, coilCount do
		local coilPart = Instance.new("Part")
		coilPart.Name = "CoilSegment"
		coilPart.Shape = Enum.PartType.Cylinder
		coilPart.Size = Vector3.new(0.35, 0.25, 0.25)
		coilPart.Color = Color3.fromRGB(15, 15, 15)
		coilPart.Material = Enum.Material.SmoothPlastic
		coilPart.Transparency = 0.1
		coilPart.CanCollide = false
		coilPart.Parent = hammerModel

		local progress = (i / coilCount) - 0.5
		local yPos = progress * 3.6
		local angle = progress * math.pi * 6.5
		local radius = 1.52

		local xPos = math.cos(angle) * radius
		local zPos = math.sin(angle) * radius

		local coilWeld = Instance.new("Weld")
		coilWeld.Part0 = hammerBody
		coilWeld.Part1 = coilPart
		coilWeld.C0 = CFrame.new(yPos, xPos, zPos) * CFrame.Angles(angle, 0, math.rad(90))
		coilWeld.Parent = hammerBody
	end

	local gripY = (leftHand.Name == "Left Arm") and -0.8 or -0.2
	local motor = Instance.new("Motor6D")
	motor.Name = "LeftGrip"
	motor.Part0 = leftHand
	motor.Part1 = handle
	motor.C0 = CFrame.new(0.2, gripY, -0.6) * CFrame.Angles(math.rad(10), math.rad(-95), math.rad(15))
	motor.Parent = handle

	hammerModel.Parent = character
	return hammerModel
end

