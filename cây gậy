-- 1. Custom Glow Sword
local function createCustomSword(char)
	if not char then return end
	if currentCustomSword then 
		currentCustomSword:Destroy() 
		currentCustomSword = nil
	end

	local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if not rightHand then return end

	local swordModel = Instance.new("Model")
	swordModel.Name = "CustomClientSword"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 1.2, 0.3)
	handle.Color = Color3.fromRGB(100, 50, 0)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Parent = swordModel

	local blade = Instance.new("Part")
	blade.Name = "Blade"
	blade.Size = Vector3.new(0.05, 3.8, 0.8)
	blade.Color = DEFAULT_BLADE_COLOR
	blade.Material = Enum.Material.Metal
	blade.CanCollide = false
	blade.Parent = swordModel

	local bladeWeld = Instance.new("Weld")
	bladeWeld.Part0 = handle
	bladeWeld.Part1 = blade
	bladeWeld.C0 = CFrame.new(0, 2.5, 0)
	bladeWeld.Parent = handle

	local motor = Instance.new("Motor6D")
	motor.Name = "SwordMotor"
	motor.Part0 = rightHand
	motor.Part1 = handle
	motor.C0 = CFrame.new(0, -0.2, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	motor.Parent = handle

	swordModel.Parent = char
	currentCustomSword = swordModel

	applyGlowEffect()
	return motor
end

-- 2. Staff
local function createRightStaff()
	local hand = getTargetHand(isLeftHandMode)
	if not hand then return nil end

	local staffModel = Instance.new("Model")
	staffModel.Name = "ClientStaff"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Shape = Enum.PartType.Cylinder
	handle.Size = Vector3.new(1, 0.38, 0.38)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Parent = staffModel

	local rodLength = currentStaffLength
	local neonRadius = 0.33

	local rod = Instance.new("Part")
	rod.Name = "Rod"
	rod.Shape = Enum.PartType.Cylinder
	rod.Size = Vector3.new(rodLength, neonRadius, neonRadius)
	rod.Color = currentStaffColor
	rod.Material = Enum.Material.Neon
	rod.CanCollide = false
	rod.Parent = staffModel

	local rodWeld = Instance.new("Weld")
	rodWeld.Part0 = handle
	rodWeld.Part1 = rod
	rodWeld.Parent = handle

	local cap1 = Instance.new("Part")
	cap1.Name = "StaffCap1"
	cap1.Shape = Enum.PartType.Ball
	cap1.Size = Vector3.new(neonRadius, neonRadius, neonRadius)
	cap1.Color = currentStaffColor
	cap1.Material = Enum.Material.Neon
	cap1.CanCollide = false
	cap1.Parent = staffModel

	local cap1Weld = Instance.new("Weld")
	cap1Weld.Part0 = rod
	cap1Weld.Part1 = cap1
	cap1Weld.C0 = CFrame.new(rodLength / 2, 0, 0)
	cap1Weld.Parent = rod

	local cap2 = Instance.new("Part")
	cap2.Name = "StaffCap2"
	cap2.Shape = Enum.PartType.Ball
	cap2.Size = Vector3.new(neonRadius, neonRadius, neonRadius)
	cap2.Color = currentStaffColor
	cap2.Material = Enum.Material.Neon
	cap2.CanCollide = false
	cap2.Parent = staffModel

	local cap2Weld = Instance.new("Weld")
	cap2Weld.Part0 = rod
	cap2Weld.Part1 = cap2
	cap2Weld.C0 = CFrame.new(-rodLength / 2, 0, 0)
	cap2Weld.Parent = rod

	local handleGripLength = 2.8
	local gripBase = Instance.new("Part")
	gripBase.Name = "GripBase"
	gripBase.Shape = Enum.PartType.Cylinder
	gripBase.Size = Vector3.new(handleGripLength, 0.38, 0.38)
	gripBase.Color = Color3.fromRGB(240, 240, 240)
	gripBase.Material = Enum.Material.SmoothPlastic
	gripBase.CanCollide = false
	gripBase.Parent = staffModel

	local gripWeld = Instance.new("Weld")
	gripWeld.Part0 = handle
	gripWeld.Part1 = gripBase
	gripWeld.Parent = handle

	for _, side in ipairs({1, -1}) do
		local endCap = Instance.new("Part")
		endCap.Name = "GripEndCap"
		endCap.Shape = Enum.PartType.Cylinder
		endCap.Size = Vector3.new(0.2, 0.44, 0.44)
		endCap.Color = Color3.fromRGB(25, 25, 25)
		endCap.Material = Enum.Material.SmoothPlastic
		endCap.CanCollide = false
		endCap.Parent = staffModel

		local endWeld = Instance.new("Weld")
		endWeld.Part0 = gripBase
		endWeld.Part1 = endCap
		endWeld.C0 = CFrame.new(side * (handleGripLength / 2), 0, 0)
		endWeld.Parent = gripBase
	end

	local ringCount = 4
	local spacing = handleGripLength / (ringCount + 1)
	
	for i = 1, ringCount do
		local offset = - (handleGripLength / 2) + (i * spacing)
		local ring = Instance.new("Part")
		ring.Name = "GripRing"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.1, 0.4, 0.4)
		ring.Color = Color3.fromRGB(20, 20, 20)
		ring.Material = Enum.Material.SmoothPlastic
		ring.CanCollide = false
		ring.Parent = staffModel

		local ringWeld = Instance.new("Weld")
		ringWeld.Part0 = gripBase
		ringWeld.Part1 = ring
		ringWeld.C0 = CFrame.new(offset, 0, 0)
		ringWeld.Parent = gripBase
	end

	local gripY = (hand.Name == "Right Arm" or hand.Name == "Left Arm") and -0.8 or -0.2
	local motor = Instance.new("Motor6D")
	motor.Name = "StaffGrip"
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = CFrame.new(0, gripY, 0) * CFrame.Angles(0, math.rad(90), math.rad(-15))
	motor.Parent = handle

	staffModel.Parent = character
	return staffModel
end

-- 3. Spring Hammer
local function createSpringHammer()
	local hand = getTargetHand(not isLeftHandMode)
	if not hand then return end

	local hammerModel = Instance.new("Model")
	hammerModel.Name = "SpringHammerModel"

	local mainColor = Color3.fromRGB(35, 38, 45)
	local glassMaterial = Enum.Material.Glass
	local glassTrans = 0.55

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(6.5, 0.45, 0.45)
	handle.Shape = Enum.PartType.Cylinder
	handle.Color = mainColor
	handle.Material = glassMaterial
	handle.Transparency = glassTrans
	handle.CanCollide = false
	handle.Parent = hammerModel

	local hammerBody = Instance.new("Part")
	hammerBody.Name = "HammerBody"
	hammerBody.Shape = Enum.PartType.Cylinder
	hammerBody.Size = Vector3.new(1.8, 1.8, 1.8)
	hammerBody.Color = mainColor
	hammerBody.Material = glassMaterial
	hammerBody.Transparency = glassTrans
	hammerBody.CanCollide = false
	hammerBody.Parent = hammerModel

	local bodyWeld = Instance.new("Weld")
	bodyWeld.Part0 = handle
	bodyWeld.Part1 = hammerBody
	bodyWeld.C0 = CFrame.new(3.25, 0, 0) * CFrame.Angles(0, 0, math.rad(90))
	bodyWeld.Parent = handle

	local steps = 3
	local baseOffset = 0.9
	local segmentThickness = 0.5

	for _, dir in ipairs({1, -1}) do
		for i = 1, steps do
			local currentDiameter = 1.8 + (i * 0.6)
			local distOffset = baseOffset + ((i - 1) * segmentThickness) + (segmentThickness / 2)

			local capSegment = Instance.new("Part")
			capSegment.Name = "TaperedCap"
			capSegment.Shape = Enum.PartType.Cylinder
			capSegment.Size = Vector3.new(segmentThickness, currentDiameter, currentDiameter)
			capSegment.Color = mainColor
			capSegment.Material = glassMaterial
			capSegment.Transparency = glassTrans
			capSegment.CanCollide = false
			capSegment.Parent = hammerModel

			local capWeld = Instance.new("Weld")
			capWeld.Part0 = hammerBody
			capWeld.Part1 = capSegment
			capWeld.C0 = CFrame.new(dir * distOffset, 0, 0)
			capWeld.Parent = hammerBody
		end
	end
	
	local centerBelt = Instance.new("Part")
	centerBelt.Name = "CenterBelt"
	centerBelt.Shape = Enum.PartType.Cylinder
	centerBelt.Size = Vector3.new(0.6, 2.0, 2.0)
	centerBelt.Color = Color3.fromRGB(20, 22, 28)
	centerBelt.Material = Enum.Material.SmoothPlastic
	centerBelt.Transparency = 0.2
	centerBelt.CanCollide = false
	centerBelt.Parent = hammerModel

	local beltWeld = Instance.new("Weld")
	beltWeld.Part0 = hammerBody
	beltWeld.Part1 = centerBelt
	beltWeld.C0 = CFrame.new(0, 0, 0)
	beltWeld.Parent = hammerBody

	for i = 1, 8 do
		local spike = Instance.new("Part")
		spike.Name = "Spike"
		spike.Size = Vector3.new(0.3, 0.3, 0.3)
		spike.Color = Color3.fromRGB(15, 15, 18)
		spike.Material = Enum.Material.SmoothPlastic
		spike.CanCollide = false
		spike.Parent = hammerModel

		local angle = math.rad(i * (360 / 8))
		local xOffset = math.cos(angle) * 1.05
		local zOffset = math.sin(angle) * 1.05

		local spikeWeld = Instance.new("Weld")
		spikeWeld.Part0 = centerBelt
		spikeWeld.Part1 = spike
		spikeWeld.C0 = CFrame.new(0, xOffset, zOffset) * CFrame.Angles(angle, 0, 0)
		spikeWeld.Parent = centerBelt
	end

	local coilCount = 16
	for i = 1, coilCount do
		local coilPart = Instance.new("Part")
		coilPart.Name = "CoilSegment"
		coilPart.Shape = Enum.PartType.Cylinder
		coilPart.Size = Vector3.new(0.3, 0.22, 0.22)
		coilPart.Color = Color3.fromRGB(15, 15, 15)
		coilPart.Material = Enum.Material.SmoothPlastic
		coilPart.Transparency = 0.1
		coilPart.CanCollide = false
		coilPart.Parent = hammerModel

		local progress = (i / coilCount) - 0.5
		local yPos = progress * 3.0
		local angle = progress * math.pi * 5.5
		local radius = 1.35

		local xPos = math.cos(angle) * radius
		local zPos = math.sin(angle) * radius

		local coilWeld = Instance.new("Weld")
		coilWeld.Part0 = hammerBody
		coilWeld.Part1 = coilPart
		coilWeld.C0 = CFrame.new(yPos, xPos, zPos) * CFrame.Angles(angle, 0, math.rad(90))
		coilWeld.Parent = hammerBody
	end

	local gripY = (hand.Name == "Left Arm" or hand.Name == "Right Arm") and -0.8 or -0.2
	local motor = Instance.new("Motor6D")
	motor.Name = "HammerGrip"
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = CFrame.new(0.2, gripY, -0.6) * CFrame.Angles(math.rad(10), math.rad(-95 + 180), math.rad(15))
	motor.Parent = handle

	hammerModel.Parent = character
	return hammerModel
end

-- 4. Dual Karambit
local function createSingleKarambit(handPart, isLeft)
	local model = Instance.new("Model")
	model.Name = isLeft and "Karambit_L" or "Karambit_R"

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.7, 0.25)
	handle.Color = Color3.fromRGB(25, 25, 25)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Parent = model

	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.12, 0.3, 0.3)
	ring.Color = Color3.fromRGB(15, 15, 15)
	ring.Material = Enum.Material.SmoothPlastic
	ring.CanCollide = false
	ring.Parent = model

	local ringWeld = Instance.new("Weld")
	ringWeld.Part0 = handle
	ringWeld.Part1 = ring
	ringWeld.C0 = CFrame.new(0, -0.4, 0) * CFrame.Angles(0, 0, math.rad(90))
	ringWeld.Parent = handle

	local bladeSegments = 6
	local prevPart = handle
	local curOffset = CFrame.new(0, 0.3, 0)

	for i = 1, bladeSegments do
		local alpha = i / bladeSegments
		local bladePart = Instance.new("Part")
		bladePart.Name = "BladePart"
		bladePart.Size = Vector3.new(0.06, 0.2, 0.22 - (alpha * 0.14))
		bladePart.Color = Color3.fromRGB(180, 180, 185)
		bladePart.Material = Enum.Material.Metal
		bladePart.CanCollide = false
		bladePart.Parent = model

		local curveAngle = math.rad(-15)
		local weld = Instance.new("Weld")
		weld.Part0 = prevPart
		if i == 1 then
			weld.Part1 = bladePart
			weld.C0 = curOffset * CFrame.Angles(curveAngle, 0, 0)
		else
			weld.Part1 = bladePart
			weld.C0 = CFrame.new(0, 0.16, -0.03) * CFrame.Angles(curveAngle, 0, 0)
		end
		weld.Parent = prevPart
		prevPart = bladePart
	end

	local isR6 = (handPart.Name == "Right Arm" or handPart.Name == "Left Arm")
	local yOffset = isR6 and -0.85 or -0.1

	local motor = Instance.new("Motor6D")
	motor.Name = isLeft and "KarambitLeftGrip" or "KarambitRightGrip"
	motor.Part0 = handPart
	motor.Part1 = handle
	motor.C0 = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), math.rad(180), math.rad(isLeft and -15 or 15))
	motor.Parent = handle

	model.Parent = character
	return model
end

local function createDualKarambit()
	local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local leftHand = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	
	local dualContainer = Instance.new("Model")
	dualContainer.Name = "DualKarambitModel"

	if rightHand then createSingleKarambit(rightHand, false).Parent = dualContainer end
	if leftHand then createSingleKarambit(leftHand, true).Parent = dualContainer end

	dualContainer.Parent = character
	return dualContainer
end

