local isRightStaffOn = false
local isLeftHammerOn = false
local isDualKarambitOn = false
local isDualSwordsOn = false
local isSlippersOn = false
local isSpinning = false

local currentRightStaff = nil
local currentLeftHammer = nil
local currentDualKarambit = nil
local currentDualSwords = nil
local currentSlippers = nil
local spinConnection = nil

local function updateSpinning(dt)
	if not isSpinning or not currentRightStaff then return end
	local handle = currentRightStaff:FindFirstChild("Handle")
	if not handle then return end

	local motor = handle:FindFirstChild("RightGrip")
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	
	if motor and torso then
		local spinSpeed = 25
		local angle = (tick() * spinSpeed) % (math.pi * 2)
		motor.Part0 = torso
		motor.C0 = CFrame.new(0, 0, -1.8) * CFrame.Angles(0, angle, math.rad(90))
	end
end

local function startSpin()
	if not isRightStaffOn then
		isRightStaffOn = true
		if _G.RightBtn then
			_G.RightBtn.Text = "Right Staff: ON"
			_G.RightBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		end
		currentRightStaff = createRightStaff()
	end

	isSpinning = true
	if _G.SpinBtn then
		_G.SpinBtn.Text = "Spin Staff: ON"
		_G.SpinBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	end

	if not spinConnection then
		spinConnection = RunService.RenderStepped:Connect(updateSpinning)
	end
end

local function stopSpin()
	isSpinning = false
	if _G.SpinBtn then
		_G.SpinBtn.Text = "Spin Staff: OFF"
		_G.SpinBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	end

	if spinConnection then
		spinConnection:Disconnect()
		spinConnection = nil
	end

	if currentRightStaff then
		local handle = currentRightStaff:FindFirstChild("Handle")
		local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
		if handle and rightHand then
			local motor = handle:FindFirstChild("RightGrip")
			if motor then
				local gripY = (rightHand.Name == "Right Arm") and -0.8 or -0.2
				motor.Part0 = rightHand
				motor.C0 = CFrame.new(0, gripY, 0) * CFrame.Angles(0, math.rad(90), math.rad(-15))
			end
		end
	end
end

