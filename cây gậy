-- ==========================================
-- HÀM TRỢ GIÚP VÀ PHÁT SÁNG
-- ==========================================
local function getTargetHand(isLeft)
	if isLeft then
		return character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	else
		return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	end
end

local function applyGlowEffect()
	if not currentCustomSword then return end
	local blade = currentCustomSword:FindFirstChild("Blade")

	if blade then
		if isGlowing then
			blade.Material = Enum.Material.Neon
			blade.Color = selectedGlowColor
		else
			blade.Material = Enum.Material.Metal
			blade.Color = DEFAULT_BLADE_COLOR
		end
	end
end

local function updateStaffColorParts(staffModel, newColor)
	if not staffModel then return end
	for _, part in ipairs(staffModel:GetChildren()) do
		if part.Name == "Rod" or part.Name == "StaffCap1" or part.Name == "StaffCap2" then
			part.Color = newColor
		end
	end
end

