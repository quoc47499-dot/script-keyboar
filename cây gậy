	local tipWeld = Instance.new("Weld")
	tipWeld.Part0 = blade
	tipWeld.Part1 = tip
	tipWeld.C0 = CFrame.new(0, 2.05, 0) * CFrame.Angles(0, math.rad(90), 0)
	tipWeld.Parent = blade

	local isR6 = (handPart.Name == "Right Arm" or handPart.Name == "Left Arm")
	local yOffset = isR6 and -0.9 or -0.12

	local motor = Instance.new("Motor6D")
	motor.Name = isLeft and "SwordLeftGrip" or "SwordRightGrip"
	motor.Part0 = handPart
	motor.Part1 = handle

	if isLeft then
		motor.C0 = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(-88), math.rad(8), math.rad(-12))
	else
		motor.C0 = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(-88), math.rad(-8), math.rad(12))
	end

	motor.Parent = handle

	model.Parent = character
	return model
end

local function createDualSwords()
	local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local leftHand = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	
	local dualContainer = Instance.new("Model")
	dualContainer.Name = "DualSwordsModel"

	if rightHand then createSingleBlackSword(rightHand, false).Parent = dualContainer end
	if leftHand then createSingleBlackSword(leftHand, true).Parent = dualContainer end

	dualContainer.Parent = character
	return dualContainer
end
-- ==========================================
-- ĐỘNG TÁC CHÉM (PERFORM SLASH)
-- ==========================================
local function performSlash()
	if isAnimating or not character then return end
	isAnimating = true

	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
	local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	
	if not torso or not rightHand then 
		isAnimating = false 
		return 
	end

	local shoulder = torso:FindFirstChild("Right Shoulder") or rightHand:FindFirstChild("RightShoulder") or torso:FindFirstChild("RightShoulder")
	local swordMotor = currentCustomSword and currentCustomSword.Handle:FindFirstChild("SwordMotor")

	if not swordMotor then
		createCustomSword(character)
		swordMotor = currentCustomSword and currentCustomSword.Handle:FindFirstChild("SwordMotor")
	end

	if shoulder and swordMotor then
		local origShoulderC0 = shoulder.C0
		local origSwordC0 = swordMotor.C0

		local t1 = TweenService:Create(shoulder, TweenInfo.new(0.12), {
			C0 = origShoulderC0 * CFrame.Angles(math.rad(110), math.rad(-20), math.rad(30))
		})
		t1:Play()
		t1.Completed:Wait()

		local t2 = TweenService:Create(shoulder, TweenInfo.new(0.08), {
			C0 = origShoulderC0 * CFrame.Angles(math.rad(20), math.rad(40), math.rad(-40))
		})
		local t2_sword = TweenService:Create(swordMotor, TweenInfo.new(0.08), {
			C0 = origSwordC0 * CFrame.Angles(math.rad(180), 0, 0)
		})
		t2:Play()
		t2_sword:Play()
		t2.Completed:Wait()

		local t3 = TweenService:Create(shoulder, TweenInfo.new(0.15), {C0 = origShoulderC0})
		local t3_sword = TweenService:Create(swordMotor, TweenInfo.new(0.15), {C0 = origSwordC0})
		t3:Play()
		t3_sword:Play()
		t3.Completed:Wait()
	end

	isAnimating = false
end

-- ==========================================
-- KÉO SLIDER MÀU SÁNG
-- ==========================================
local isDraggingColor = false

local function updateColor(input)
	local sliderAbsPos = sliderFrame.AbsolutePosition.X
	local sliderAbsSize = sliderFrame.AbsoluteSize.X
	local x = math.clamp(input.Position.X - sliderAbsPos, 0, sliderAbsSize)
	local alpha = x / sliderAbsSize

	sliderPicker.Position = UDim2.new(alpha, -3, 0, -2)
	selectedGlowColor = Color3.fromHSV(alpha, 1, 1)
	colorPreview.BackgroundColor3 = selectedGlowColor

	applyGlowEffect()
end

sliderFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingColor = true
		updateColor(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingColor and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateColor(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingColor = false
	end
end)

-- ==========================================
-- REFRESH VŨ KHÍ KHI ĐỔI TAY
-- ==========================================
local function refreshWeapons()
	if currentRightStaff then currentRightStaff:Destroy() currentRightStaff = nil end
	if currentLeftHammer then currentLeftHammer:Destroy() currentLeftHammer = nil end
	if currentDualKarambit then currentDualKarambit:Destroy() currentDualKarambit = nil end
	if currentDualSwords then currentDualSwords:Destroy() currentDualSwords = nil end

	if isRightStaffOn then currentRightStaff = createRightStaff() end
	if isLeftHammerOn then currentLeftHammer = createSpringHammer() end
	if isDualKarambitOn then currentDualKarambit = createDualKarambit() end
	if isDualSwordsOn then currentDualSwords = createDualSwords() end
end

-- ==========================================
-- VÒNG LẶP AUTO SWING
-- ==========================================
task.spawn(function()
	while true do
		task.wait(0.05)
		if isSwinging then
			if not currentCustomSword or not currentCustomSword.Parent or not currentCustomSword:IsDescendantOf(workspace) then
				createCustomSword(character)
			end
			performSlash()
		else
			if currentCustomSword and not isSwinging then
				currentCustomSword:Destroy()
				currentCustomSword = nil
			end
		end
	end
end)

