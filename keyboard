local camFrame, camBody = createBasePanel("CamPanel", "🎥 ĐIỀU KHIỂN CAMERA", UDim2.new(0, 180, 0, 150), UDim2.new(0.7, 0, 0.5, 0))
camFrame.Visible = false

local function forceRotateCamera(deltaX, deltaY, sensitivity)
    sensitivity = sensitivity or 0.4
    Camera = workspace.CurrentCamera
    if not Camera then return end

    if Camera.CameraType == Enum.CameraType.Fixed then
        Camera.CameraType = Enum.CameraType.Custom
    end

    local focusPos = Camera.Focus.Position
    local camPos = Camera.CFrame.Position
    local distance = (camPos - focusPos).Magnitude
    if distance < 0.2 then distance = 5 end

    local currentCFrame = Camera.CFrame
    local yaw = CFrame.Angles(0, math.rad(-deltaX * sensitivity), 0)
    local pitch = CFrame.Angles(math.rad(-deltaY * sensitivity), 0, 0)

    Camera.CFrame = CFrame.new(focusPos) 
        * yaw 
        * pitch 
        * CFrame.new(0, 0, distance) 
        * (currentCFrame - currentCFrame.Position)
end

local function createCamBtn(name, text, pos, size, deltaX, deltaY)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
    btn.BackgroundTransparency = 0.2
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.Parent = camBody
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Down:Connect(function()
        playKeySound()
        local holding = true
        
        local connUp, connLeave
        connUp = btn.MouseButton1Up:Connect(function()
            holding = false
            if connUp then connUp:Disconnect() end
            if connLeave then connLeave:Disconnect() end
        end)
        
        connLeave = btn.MouseLeave:Connect(function()
            holding = false
            if connUp then connUp:Disconnect() end
            if connLeave then connLeave:Disconnect() end
        end)

        task.spawn(function()
            while holding do
                forceRotateCamera(deltaX, deltaY, 0.4)
                RunService.RenderStepped:Wait()
            end
        end)
    end)

    return btn
end

